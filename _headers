# Cloudflare Pages custom headers.
# CSP allows: self-hosted assets, Google Fonts (style/font), the analytics
# domains used by script.js (GA4 + Yandex Metrika), and the OpenStreetMap
# iframe embedded in the contacts section. Loosen only if you add more
# third-party scripts/services.
#
# Cache-Control: index.html/privacy.html/analitics.html, style.css and
# script.js all keep the same filename across deploys (no content hash), so
# they must always revalidate — otherwise a returning visitor's browser can
# keep serving a pre-deploy copy indefinitely. `must-revalidate` still lets
# the browser send a conditional request and get a cheap 304 when nothing
# changed, it just never serves a stale copy after a real deploy. Only the
# binary assets below are safe to cache for a year, since changing them
# means renaming the file (if og-image.png is ever swapped for a new social
# preview, rename it — e.g. og-image-2.png — rather than overwriting in
# place, otherwise cached copies and link-preview caches on Telegram/etc.
# will keep showing the old image for a while).
/*
  Content-Security-Policy: default-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://mc.yandex.ru; script-src 'self' https://www.googletagmanager.com https://mc.yandex.ru; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://mc.yandex.ru; frame-src https://www.openstreetmap.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Cache-Control: public, max-age=0, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

/favicon.png
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

/og-image.png
  Cache-Control: public, max-age=31536000, immutable
